{
  "$schema": "../../frontend/node_modules/wrangler/config-schema.json",
  "name": "aladdin-whatsapp-otp-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true
  },
  "vars": {
    "WHATSAPP_PHONE_NUMBER_ID": "1458603463983505",
    "WHATSAPP_OTP_TEMPLATE": "aladdin_otp",
    "WHATSAPP_OTP_LANGUAGES": "ar",
    "OTP_ENVIRONMENT": "acceptance",
    "OTP_RECIPIENT_MODE": "open",
    "WHATSAPP_GRAPH_API_VERSION": "v25.0",
    "OTP_NOTIFY_URL": "https://aladdin-frontend-preview.bstalent9.workers.dev/api/internal/whatsapp-otp/notify",
    "WHATSAPP_DELIVERY_ENABLED": "true"
  },
  "triggers": { "crons": ["* * * * *"] },
  "secrets_store_secrets": [
    { "binding": "OTP_ADMIN_SIGNING_SECRET", "store_id": "acfaa67f391e499db6fde398022f50ce", "secret_name": "OTP_ADMIN_SIGNING_SECRET" },
    { "binding": "OTP_NOTIFY_SIGNING_SECRET", "store_id": "acfaa67f391e499db6fde398022f50ce", "secret_name": "OTP_NOTIFY_SIGNING_SECRET" },
    { "binding": "OTP_ADMIN_GRANT_SECRET", "store_id": "acfaa67f391e499db6fde398022f50ce", "secret_name": "OTP_ADMIN_GRANT_SECRET" },
    {
      "binding": "WHATSAPP_ACCESS_TOKEN",
      "store_id": "acfaa67f391e499db6fde398022f50ce",
      "secret_name": "WHATSAPP_ACCESS_TOKEN"
    },
    {
      "binding": "OTP_SIGNING_SECRET",
      "store_id": "acfaa67f391e499db6fde398022f50ce",
      "secret_name": "PHONE_OTP_WORKER_SECRET"
    }
  ],
  "services": [
    { "binding": "APP_NOTIFY", "service": "aladdin-frontend-preview" }
  ],
  "d1_databases": [
    {
      "binding": "IDEMPOTENCY_DB",
      "database_name": "aladdin-whatsapp-otp-acceptance",
      "database_id": "da65d5e4-8344-4078-9c2d-8a4bb4907f79",
      "migrations_dir": "migrations"
    }
  ]
}
