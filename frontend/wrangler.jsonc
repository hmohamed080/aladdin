{
  // Cloudflare Workers host for the Next.js frontend (ADR-0021). Built with
  // `pnpm cf:build` (OpenNext). The live host since the 2026-10-27 cutover.
  // Secrets are never written here: set them with `wrangler secret put` per
  // environment (see docs/guides/cloudflare-frontend.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aladdin-frontend",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "aladdin-frontend" }],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true },
  // The deployed version id keys the edge cache of optimized images (cloudflare/worker.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Local (`wrangler dev`) reads its variables from .dev.vars (never committed).
  "workers_dev": false,

  "env": {
    // Isolated acceptance preview on workers.dev: aladdin-r2-acceptance Supabase
    // project and the acceptance R2 buckets only. No custom domain.
    "preview": {
      "name": "aladdin-frontend-preview",
      "workers_dev": true,
      "preview_urls": true,
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "aladdin-frontend-preview" },
        { "binding": "BACKEND", "service": "aladdin-backend-preview" }
      ],
      "images": { "binding": "IMAGES" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "NEXT_PUBLIC_APP_ENV": "staging",
        "REDIS_CACHE_ENABLED": "true",
        "REDIS_REST_URL": "https://alert-bedbug-148148.upstash.io",
        "REDIS_KEY_ENV": "cf-preview",
        // R2 (stage 2): the acceptance private bucket only. R2_ACCOUNT_ID comes from the
        // deploy workflow; the bucket-scoped keys and SUPABASE_SERVICE_ROLE_KEY are Worker secrets.
        "R2_STORAGE_ENABLED": "true",
        "R2_PRODUCTION_WRITES_APPROVED": "false",
        "R2_PRIVATE_BUCKET": "aladdin-r2-acceptance-20261011-private",
        // Siteverify must report this hostname, or the CAPTCHA check fails closed.
        "TURNSTILE_ALLOWED_HOSTNAMES": "aladdin-frontend-preview.bstalent9.workers.dev",
        // Contact-email links point back at the preview, never at production.
        // RESEND_API_KEY is a Worker secret.
        "EMAIL_FROM": "Aladdin <no-reply@aladdindecore.com>",
        "APP_PUBLIC_ORIGIN": "https://aladdin-frontend-preview.bstalent9.workers.dev",
        // Approved Meta Authentication template for sign-up codes. WHATSAPP_ACCESS_TOKEN
        // and WHATSAPP_PHONE_NUMBER_ID are Worker secrets.
        "WHATSAPP_OTP_TEMPLATE": "aladdin_login_code"
      }
    },
    // Isolated Admin View-As review Worker (Registration keeps `preview` untouched). Same Acceptance Supabase project,
    // its OWN Worker name, secrets, Redis key prefix and origin. It is deployed DARK: no workers.dev route and no preview
    // URLs until Cloudflare Access protects the Worker and the owner enables the route (docs/admin/ADMIN_VIEW_AS_PREVIEW_DEPLOYMENT_PLAN.md).
    // Hosted media delivery is OFF (R2_STORAGE_ENABLED=false): Admin View-As shows placeholders until Stage 4 is approved.
    "viewas-preview": {
      "name": "aladdin-frontend-viewas-preview",
      "workers_dev": false,
      "preview_urls": false,
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "aladdin-frontend-viewas-preview" },
        { "binding": "BACKEND", "service": "aladdin-backend-preview" }
      ],
      "images": { "binding": "IMAGES" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "NEXT_PUBLIC_APP_ENV": "staging",
        "ADMIN_VIEW_AS_ENABLED": "true",
        // Redis stays OFF here: the owner accepted it for the `preview` Worker only, and off means this Worker can never
        // share a cache key (or the Upstash instance) with Registration's preview.
        "REDIS_CACHE_ENABLED": "false",
        "R2_STORAGE_ENABLED": "false",
        "R2_PRODUCTION_WRITES_APPROVED": "false",
        "R2_PRIVATE_BUCKET": "aladdin-r2-acceptance-20261011-private",
        "TURNSTILE_ALLOWED_HOSTNAMES": "aladdin-frontend-viewas-preview.bstalent9.workers.dev",
        "EMAIL_FROM": "Aladdin <no-reply@aladdindecore.com>",
        "APP_PUBLIC_ORIGIN": "https://aladdin-frontend-viewas-preview.bstalent9.workers.dev"
      }
    },
    // Production: deployed only after the owner approves the cutover. Routes
    // (aladdindecore.com) are added at cutover, not before. Deployed by the manual
    // `Cloudflare production` workflow, backend first: the BACKEND service must exist.
    "production": {
      "name": "aladdin-frontend-production",
      "workers_dev": false,
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "aladdin-frontend-production" },
        { "binding": "BACKEND", "service": "aladdin-backend-production" }
      ],
      "images": { "binding": "IMAGES" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "NEXT_PUBLIC_APP_ENV": "production",
        // Siteverify (phone sign-up) must report one of these, or the check fails closed.
        // A test hostname is added here only while it is approved and attached
        // (next.aladdindecore.com was, for stage 11; removed 2026-10-28 after the cutover).
        "TURNSTILE_ALLOWED_HOSTNAMES": "aladdindecore.com,www.aladdindecore.com",
        // Contact-email verification links go out through Resend from the verified
        // aladdindecore.com domain. RESEND_API_KEY is a Worker secret.
        "EMAIL_FROM": "Aladdin <no-reply@aladdindecore.com>",
        "APP_PUBLIC_ORIGIN": "https://aladdindecore.com",
        // Sign-up codes over WhatsApp. WHATSAPP_ACCESS_TOKEN and WHATSAPP_PHONE_NUMBER_ID
        // are Worker secrets; until they are set, mobile-number sign-up says it is unavailable.
        "WHATSAPP_OTP_TEMPLATE": "aladdin_login_code",
        // First cutover: media stays on Supabase Storage and Redis stays off. Each one
        // is turned on later by its own approval.
        "R2_STORAGE_ENABLED": "false",
        "R2_PRODUCTION_WRITES_APPROVED": "false",
        "REDIS_CACHE_ENABLED": "false"
      },
      // Checked by `wrangler deploy`: the deploy fails if one is not set. The owner
      // sets them with `wrangler secret put <NAME> --env production` (never in this file).
      "secrets": { "required": ["SUPABASE_SERVICE_ROLE_KEY", "TURNSTILE_SECRET_KEY", "AUTH_PASSWORD_PREVIEW_GRANT_SECRET"] }
    }
  }
}
